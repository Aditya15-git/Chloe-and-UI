# ── Twilio ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+61xxxxxxxxx
TWILIO_HUMAN_RECEPTIONIST=+61xxxxxxxxx   # Human receptionist; leave blank to disable transfer

# ── AWS Bedrock (Claude Haiku) ───────────────────────────
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001

# ── Deepgram (STT) ───────────────────────────────────────
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-AU

# ── TTS Provider ─────────────────────────────────────────
# Options: cartesia | polly | elevenlabs | deepgram_aura
TTS_PROVIDER=cartesia

# Cartesia (used when TTS_PROVIDER=cartesia)
CARTESIA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
CARTESIA_MODEL_ID=sonic-english

# ElevenLabs (used when TTS_PROVIDER=elevenlabs)
# Common voice IDs: Rachel=21m00Tcm4TlvDq8ikWAM  Adam=pNInz6obpgDQGcFmaJgB
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Deepgram Aura (used when TTS_PROVIDER=deepgram_aura, reuses DEEPGRAM_API_KEY above)
# Models: aura-asteria-en | aura-luna-en | aura-stella-en | aura-athena-en
#         aura-hera-en    | aura-orion-en | aura-arcas-en | aura-perseus-en
#         aura-angus-en   | aura-orpheus-en | aura-helios-en | aura-zeus-en
DEEPGRAM_TTS_MODEL=aura-asteria-en

# Amazon Polly (used when TTS_PROVIDER=polly, uses AWS credentials above)
POLLY_VOICE_ID=Olivia           # Australian English voice
POLLY_ENGINE=neural
POLLY_LANGUAGE_CODE=en-AU

# ── S3 Transcripts ───────────────────────────────────────
# Uses the same AWS credentials as Bedrock above.
# Leave S3_TRANSCRIPT_BUCKET blank to disable uploads.
S3_TRANSCRIPT_BUCKET=my-clinic-transcripts
S3_TRANSCRIPT_PREFIX=transcripts

# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# ── App ──────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=https://your-ngrok-or-domain.com   # public URL Twilio hits
LOG_LEVEL=INFO
CLINIC_NAME=My Medical Clinic
EMERGENCY_NUMBER=000
